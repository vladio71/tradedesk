# Copy to .env for local runs without docker. docker compose has defaults for all of these.

NODE_ENV=development

# Shared by all services. HS256. Use a long random value. Production should use asymmetric keys (see README).
JWT_SECRET=dev-only-secret-change-me-0123456789
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# true when the site is served over https. false so cookies work on http://localhost
COOKIE_SECURE=false

# Local Postgres (one server, three databases, see docker/postgres/init.sql)
IDENTITY_DATABASE_URL=postgres://tradedesk:tradedesk@localhost:5432/identity
WALLET_DATABASE_URL=postgres://tradedesk:tradedesk@localhost:5432/wallet
MARKET_DATABASE_URL=postgres://tradedesk:tradedesk@localhost:5432/market

IDENTITY_PORT=3001
WALLET_PORT=3002
MARKET_PORT=3003

# Wallet: secret shared with the crypto provider for webhook signatures
CRYPTO_WEBHOOK_SECRET=dev-only-webhook-secret

# Market: random walk prices every second
PRICE_SIMULATOR_ENABLED=true
PRICE_SIMULATOR_INTERVAL_MS=1000
