{
  "name": "tradedesk",
  "version": "1.0.0",
  "private": true,
  "description": "Trading platform backend: identity, wallet and market services",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "libs/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @tradedesk/common && npm run build -w @tradedesk/identity-service -w @tradedesk/wallet-service -w @tradedesk/market-service",
    "start:identity": "node apps/identity-service/dist/main.js",
    "start:wallet": "node apps/wallet-service/dist/main.js",
    "start:market": "node apps/market-service/dist/main.js",
    "seed": "tsx scripts/seed.ts",
    "test": "jest --config jest.unit.config.js",
    "test:e2e": "jest --config jest.e2e.config.js --runInBand"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "bcryptjs": "3.0.3",
    "jest": "30.5.2",
    "pg": "8.23.1",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
